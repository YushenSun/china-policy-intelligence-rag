# Optional local directories. Defaults work without an .env file.
CHINA_POLICY_RAG_RAW_DATA_DIR=data/raw
CHINA_POLICY_RAG_PROCESSED_DATA_DIR=data/processed

# Optional provider selection. Never commit real credentials.
CHINA_POLICY_RAG_DATABASE_URL=
CHINA_POLICY_RAG_EMBEDDING_PROVIDER=
CHINA_POLICY_RAG_LLM_PROVIDER=
CHINA_POLICY_RAG_EMBEDDING_API_KEY=
CHINA_POLICY_RAG_LLM_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Local ingestion defaults
CHINA_POLICY_RAG_INGESTION_MANIFEST_PATH=data/raw/manifest.yaml
